# Postgres connection used by the app at runtime (e.g. Supabase session pooler)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=no-verify&connect_timeout=30"
# Connection used by the Prisma CLI (migrate/studio) via prisma.config.ts
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require&connect_timeout=60"

JWT_SECRET="change-me"

# Bootstrap Main Admin password used by prisma/seed.ts
SEED_ADMIN_PASSWORD="change-me"

# Supabase Storage for attachments (leave unset locally to use the uploads/ folder)
SUPABASE_PROJECT_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"
